#include <stdio.h>
#define MAX 5

int q[MAX], f = -1, r = -1;

void insert() {
    if ((r + 1) % MAX == f) printf("Overflow!");
    else {
        int val; printf("Enter value: "); scanf("%d", &val);
        if (f == -1) f = 0;
        r = (r + 1) % MAX;
        q[r] = val;
    }
}

void delete() {
    if (f == -1) printf("Underflow!");
    else {
        printf("Deleted: %d", q[f]);
        if (f == r) f = r = -1;
        else f = (f + 1) % MAX;
    }
}

void display() {
    if (f == -1) return;
    int i = f;
    while (1) {
        printf("%d ", q[i]);
        if (i == r) break;
        i = (i + 1) % MAX;
    }
}
