#include <stdio.h>
#include <ctype.h>

int stack[20], top = -1;

void push(int val) { stack[++top] = val; }
int pop() { return stack[top--]; }

int main() {
    char exp[20];
    printf("Enter postfix expression: ");
    scanf("%s", exp);
    
    for (int i = 0; exp[i] != '\0'; i++) {
        if (isdigit(exp[i])) push(exp[i] - '0');
        else {
            int op2 = pop();
            int op1 = pop();
            switch (exp[i]) {
                case '+': push(op1 + op2); break;
                case '-': push(op1 - op2); break;
                case '*': push(op1 * op2); break;
                case '/': push(op1 / op2); break;
            }
        }
    }
    printf("Result: %d\n", pop());
    return 0;

}
